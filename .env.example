# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole estate's
# secrets — is banned, and this file is what makes the alternative possible.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.
#
# **THE TWO SECRETS BELOW ARE LEFT EMPTY, NOT FILLED WITH A PLACEHOLDER.** `src/env.ts` refuses a
# known placeholder at boot — `change_me`, `changeme`, `secret`, `token` are all in the rejected
# set — so a placeholder here would be a value nobody could actually use, and one that a hurried
# copy-paste turns into a same-in-every-environment signing key. An empty value fails at boot with
# the variable's name in the message, which is the failure you want.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
MARKET_DATABASE_URL=postgres://market:market@127.0.0.1:5432/market

# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for event signatures — outbound AND INBOUND.
#
# Inbound, this is the key that verifies `identity.user.deleted` on POST /v1/events. That event
# cancels a departing user's listings and refunds their escrows, so an unauthenticated version of
# this endpoint is a delist-and-refund-anybody endpoint. At least 24 random characters:
#   openssl rand -base64 32
# Leaving it empty is deliberate. Do not paste a value back into this file.
OUTBOX_SIGNING_SECRET=

# The upstreams.
#
# The ledger is HARD: it holds the money, and a market that cannot reserve, capture or refund can
# still take a bid — which is the shape of the incident where a buyer's funds are gone and no order
# exists. The indexer and policy are SOFT; both have designed degradations. See index.ts step 6.
LEDGER_URL=http://127.0.0.1:4007
INDEXER_URL=http://127.0.0.1:4004
POLICY_URL=http://127.0.0.1:4011

# This service's own scoped credential. NOT shared with any other service — SD-05.
# It must carry: ledger:post, ledger:reserve, indexer:read, policy:evaluate.
MARKET_SERVICE_TOKEN=

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
MARKET_DATABASE_POOL_MAX=10

# MARKET_UPSTREAM_DEADLINE_MS=5000

# --- the money controls ------------------------------------------------------------------------
#
# These four are not tuning knobs. Each one changes what a seller is actually paid, and a wrong
# value is a money incident rather than a slow endpoint.

# The platform's cut of every sale, in basis points. 250 = 2.5%.
# MARKET_PLATFORM_FEE_BPS=250

# The ceiling a creator's royalty may not exceed, in basis points. 1000 = 10%.
#
# **CHECKED AGAINST THE FEE AT BOOT.** If the two can together reach 10,000 bps, a listing at the
# royalty ceiling settles for a seller's proceeds of exactly zero — and one basis point past it,
# for a negative number the ledger refuses AFTER the buyer's funds have been claimed for the entry.
# `loadEnv` refuses that configuration by name rather than discovering it at 03:00 on the day a
# creator sets the maximum.
# MARKET_MAX_ROYALTY_BPS=1000

# How long a buyer has to raise a dispute before the seller's proceeds become spendable. Default
# 24 hours. Zero means proceeds are available the instant the sale settles, which is a policy
# choice about who carries the fraud risk, not a performance setting.
# MARKET_DISPUTE_WINDOW_MS=86400000

# Anti-sniping. A bid inside this window of the close pushes the close out by this much. Default
# two minutes. At zero, an auction is won by whoever has the lowest latency rather than by whoever
# values the item most — a market design failure, not a bug.
# MARKET_AUCTION_EXTENSION_MS=120000

# New listings can be paused without pausing the service. Nothing already listed is affected: bids,
# settlement, payouts, disputes and moderation all continue while it is off.
# MARKET_LISTING_ENABLED=true

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process, not by src/env.ts. They belong in the deploy, not here.
#
# MARKET_TEST_DSN is read only by the test suite, and only when its name contains "test" — the
# database-backed tests truncate every table this service owns. It is named `_DSN` rather than
# `_TEST_DATABASE_URL` because micro-org's rule-1 check fails on the latter; see README.md.
